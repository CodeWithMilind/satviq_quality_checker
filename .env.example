# SATVIQ — backend environment configuration.
# Copy this file to ".env" (same folder) and fill in your key:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# The real .env file is git-ignored and must never be shared or
# included in a ZIP. The frontend never sees these values.

# Muse AI API (Meta Model API — https://dev.meta.ai/docs/overview)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

# Muse API request settings
# (Request timeouts have been removed — Muse calls are made with
# no timeout, so MUSE_TIMEOUT_SECONDS no longer exists and any old
# copy of it in your .env is ignored.)
MUSE_MAX_OUTPUT_TOKENS=
MUSE_TEMPERATURE=

# Vision support (direct image/PDF extraction fallback)
MUSE_VISION_ENABLED=true

# Optional: context window used for token-usage monitoring.
# Blank = the documented window for MUSE_MODEL (muse-spark-1.3:
# 1,048,576 tokens, per https://dev.meta.ai/docs/models).
MUSE_CONTEXT_WINDOW_TOKENS=

# Optional: maximum upload size in MB (default 5). Files above the
# limit are rejected by the backend before entering the pipeline.
# SATVIQ_MAX_UPLOAD_MB=5
