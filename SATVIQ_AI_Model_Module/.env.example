# ai_model module — example environment configuration.
# Copy to .env (or export the variables) and fill in your key.
# NEVER commit a real API key. The key is never logged by this module.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_MODEL_TIMEOUT=60
AI_MODEL_MAX_RETRIES=2
AI_MODEL_ENABLED=true

# Optional, for the future local provider placeholder:
# AI_LOCAL_BASE_URL=http://localhost:11434
